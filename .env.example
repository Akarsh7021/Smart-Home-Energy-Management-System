# Copy this file to .env before starting PostgreSQL with Docker Compose.
# The real .env file is ignored by Git.

# PostgreSQL container and Spring datasource settings
POSTGRES_DB=nightgrid
POSTGRES_USER=nightgrid
POSTGRES_PASSWORD=nightgrid_dev_password
POSTGRES_PORT=5432
DB_HOST=localhost

# React development server allowed to send credentialed API requests
FRONTEND_ORIGIN=http://localhost:5173

# Use false only when a local client cannot use HTTPS. Keep true when deployed.
SESSION_COOKIE_SECURE=false
