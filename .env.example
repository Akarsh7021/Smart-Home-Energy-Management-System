# Copy this file to .env before starting PostgreSQL with Docker Compose.
# The real .env file is ignored by Git.

# PostgreSQL container and Spring datasource settings
POSTGRES_DB=nightgrid
POSTGRES_USER=nightgrid
POSTGRES_PASSWORD=nightgrid_dev_password
POSTGRES_PORT=5432
DB_HOST=localhost

# Host port used by the Docker Compose API deployment
API_PORT=8080

# Exact Cloudflare Pages custom domain allowed to call the API.
# Production: https://nightgrid.hdashti.systems
FRONTEND_ORIGIN=http://localhost:5173

# Use false only when a local client cannot use HTTPS. Keep true when deployed.
SESSION_COOKIE_SECURE=false

# Strict works in production because nightgrid.hdashti.systems and
# nightgrid-api.hdashti.systems share the same registrable domain and scheme.
SESSION_COOKIE_SAME_SITE=strict
